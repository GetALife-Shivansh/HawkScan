# =====================================================================
# HawkScan Environment Configuration Template
# Copy this file to .env and insert your real credentials where needed.
# =====================================================================

HAWKSCAN_HOST=127.0.0.1
HAWKSCAN_PORT=9090
TARGET_URL=http://127.0.0.1:8000

# TinyFish Cloud Web Agent Engine
# (Leave empty to use local Playwright Chromium engine)
TINYFISH_API_KEY=
TINYFISH_API_URL=https://api.browser.tinyfish.ai

# LLM Reasoning Engine (Multi-provider via LiteLLM)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-3.5-flash

# Evidence storage
EVIDENCE_DIR=./evidence
